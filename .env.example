# Database (Railway provisions this automatically)
DATABASE_URL=postgresql://user:password@host:5432/cellar

# Auth
JWT_SECRET=your-random-64-char-secret-here

# OpenAI (optional — server-side key for label scanning)
OPENAI_API_KEY=sk-your-key-here

# Demo account (test@test.com)
DEMO_OPENAI_KEY=sk-your-demo-key-here
# Password for the seeded demo account (test@test.com). Required by POST /api/seed-demo.
DEMO_PASSWORD=change-me

# Environment
NODE_ENV=development
PORT=3000
