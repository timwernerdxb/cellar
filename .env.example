# Database (Railway provisions this automatically)
DATABASE_URL=postgresql://user:password@host:5432/cellar

# Auth
JWT_SECRET=your-random-64-char-secret-here

# OpenAI (optional — server-side key for label scanning)
OPENAI_API_KEY=sk-your-key-here

# Demo account (test@test.com)
DEMO_OPENAI_KEY=sk-your-demo-key-here

# Email (optional — needed to send cellar invitations; without it the app
# shows an invite link to copy and share yourself). https://resend.com
RESEND_API_KEY=re_your-key-here
MAIL_FROM=Cellar <cellar@yourdomain.com>
# Public URL used in invitation links (defaults to the request's host)
APP_URL=https://your-app.up.railway.app

# Environment
NODE_ENV=development
PORT=3000
